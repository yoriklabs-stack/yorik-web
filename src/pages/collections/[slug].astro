---
import Layout from '../../layouts/Layout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const bundles = await getCollection('bundles');
  return bundles.map((bundle) => ({
    params: { slug: bundle.slug },
    props: { bundle },
  }));
}

interface Props {
  bundle: CollectionEntry<'bundles'>;
}

const { bundle } = Astro.props;
const { Content } = await bundle.render();
---

<Layout title={`${bundle.data.name} — Yorik Labs Collection Concept`} description={bundle.data.description}>
  <div class="pt-36 pb-24 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
    
    <a href="/collections" class="inline-flex items-center gap-2 text-xs font-mono text-yorik-subtle hover:text-white transition-colors">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
      </svg>
      <span>← Back to All Collections</span>
    </a>

    <div class="p-8 sm:p-12 rounded-3xl glass-panel border border-yorik-purple/40 space-y-6">
      <div class="flex items-center justify-between">
        <span class="px-3 py-1 rounded-full text-xs font-mono font-bold uppercase tracking-wider bg-yorik-cyan/15 text-yorik-cyan border border-yorik-cyan/30">
          {bundle.data.category}
        </span>
        <span class="text-xs font-mono text-yorik-subtle">
          Future Bundle Concept
        </span>
      </div>

      <h1 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight leading-tight">
        {bundle.data.name}
      </h1>

      <p class="text-lg text-yorik-muted leading-relaxed">
        {bundle.data.description}
      </p>

      <div class="space-y-3 pt-4 border-t border-yorik-border/60">
        <span class="text-xs font-mono text-yorik-purple-glow uppercase tracking-wider block">Included Ecosystem Tools:</span>
        <div class="flex flex-wrap gap-2">
          {bundle.data.appsIncluded.map((app) => (
            <span class="px-3 py-1.5 rounded-xl bg-yorik-surface border border-yorik-border text-xs font-medium text-white">
              ✦ {app}
            </span>
          ))}
        </div>
      </div>
    </div>

    <!-- MDX Content -->
    <div class="prose prose-invert max-w-none prose-p:text-yorik-muted prose-headings:text-white p-8 rounded-2xl bg-yorik-surface/40 border border-yorik-border">
      <Content />
    </div>

  </div>
</Layout>
