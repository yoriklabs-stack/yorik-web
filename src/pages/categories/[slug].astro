---
import Layout from '../../layouts/Layout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const categories = await getCollection('categories');
  return categories.map((category) => ({
    params: { slug: category.slug },
    props: { category },
  }));
}

interface Props {
  category: CollectionEntry<'categories'>;
}

const { category } = Astro.props;
const { Content } = await category.render();

const allApps = await getCollection('apps');
const matchingApps = allApps.filter((app) => app.data.category.toLowerCase() === category.slug.toLowerCase());
---

<Layout title={`${category.data.name} — Yorik Labs Category`} description={category.data.description}>
  <div class="pt-36 pb-24 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
    
    <a href="/categories" class="inline-flex items-center gap-2 text-xs font-mono text-yorik-subtle hover:text-white transition-colors">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
      </svg>
      <span>← Back to All Categories</span>
    </a>

    <div class="p-8 sm:p-12 rounded-3xl glass-panel border border-yorik-purple/40 space-y-6">
      <span class="px-3 py-1 rounded-full text-xs font-mono font-bold uppercase tracking-wider bg-yorik-purple/20 text-yorik-purple-glow border border-yorik-purple/40 inline-block">
        Category Overview
      </span>

      <h1 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight leading-tight">
        {category.data.name} Utilities
      </h1>

      <p class="text-lg text-yorik-muted leading-relaxed">
        {category.data.description}
      </p>

      <div class="pt-4 border-t border-yorik-border/60">
        <span class="text-xs font-mono text-yorik-cyan block mb-2">Planned Category App Concepts:</span>
        <div class="flex flex-wrap gap-2">
          {category.data.exampleApps.map((app) => (
            <span class="px-3 py-1 rounded-lg bg-yorik-bg border border-yorik-border text-xs font-medium text-white">
              {app}
            </span>
          ))}
        </div>
      </div>
    </div>

    <!-- Article Content -->
    <div class="prose prose-invert max-w-none prose-p:text-yorik-muted prose-headings:text-white p-8 rounded-2xl bg-yorik-surface/40 border border-yorik-border">
      <Content />
    </div>

    <!-- Related Apps Grid -->
    {matchingApps.length > 0 && (
      <div class="space-y-6">
        <h2 class="text-2xl font-bold text-white tracking-tight">Apps Being Built in {category.data.name}</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {matchingApps.map((app) => (
            <div class="p-6 rounded-2xl glass-panel border border-yorik-border space-y-3">
              <div class="flex items-center justify-between">
                <h3 class="font-bold text-lg text-white">{app.data.name}</h3>
                <span class="text-[10px] font-mono text-yorik-cyan px-2 py-0.5 rounded bg-yorik-surface border border-yorik-border">
                  {app.data.status}
                </span>
              </div>
              <p class="text-xs text-yorik-muted">{app.data.tagline}</p>
              <a href={`/products/${app.slug}`} class="inline-block text-xs font-semibold text-yorik-purple-glow hover:text-white pt-2">
                Read Concept &rarr;
              </a>
            </div>
          ))}
        </div>
      </div>
    )}

  </div>
</Layout>
