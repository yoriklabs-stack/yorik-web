---
import { getCollection } from 'astro:content';
import SectionHeader from '../common/SectionHeader.astro';

const labs = await getCollection('labs');
---

<section id="labs" class="py-24 relative bg-yorik-surface/40 border-b border-yorik-border/50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <SectionHeader
      eyebrow="IDEAS. EXPERIMENTS. FUTURE PRODUCTS."
      headline="Where ideas grow."
      copy="Yorik Labs explores emerging technologies, new ideas and better ways to solve everyday problems."
      gradientText="Where ideas grow."
    />

    <!-- Technology Exploration Grid -->
    <div class="mt-16 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {labs.map((lab) => (
        <div class="glass-panel p-6 rounded-2xl border border-yorik-border hover:border-yorik-purple/50 transition-all duration-300 hover:-translate-y-1 flex flex-col justify-between group">
          <div>
            <!-- Header -->
            <div class="flex items-center justify-between mb-4">
              <span class="px-2.5 py-0.5 rounded-full text-[10px] font-mono font-bold text-yorik-cyan bg-yorik-cyan/10 border border-yorik-cyan/30">
                {lab.data.techTag}
              </span>
              <span class="text-[10px] font-mono text-yorik-subtle">
                Lab Experiment
              </span>
            </div>

            <!-- Name & Summary -->
            <h3 class="font-extrabold text-xl text-white mb-2 group-hover:text-yorik-purple-glow transition-colors">
              {lab.data.name}
            </h3>
            <p class="text-xs text-yorik-muted leading-relaxed mb-4">
              {lab.data.summary}
            </p>
          </div>

          <!-- Footer status -->
          <div class="pt-3 border-t border-yorik-border/60 flex items-center justify-between text-[10px] font-mono">
            <span class="text-yorik-subtle">Status</span>
            <span class="text-yorik-purple-glow font-medium">{lab.data.status}</span>
          </div>
        </div>
      ))}
    </div>

    <!-- Futuristic Lab Visual Box -->
    <div class="mt-12 p-8 rounded-3xl glass-panel border border-yorik-purple/30 text-center relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-r from-yorik-purple/10 via-yorik-cyan/10 to-transparent pointer-events-none"></div>
      
      <div class="relative z-10 max-w-2xl mx-auto space-y-4">
        <div class="w-12 h-12 mx-auto rounded-2xl bg-yorik-surface border border-yorik-purple/40 flex items-center justify-center shadow-glow">
          <span class="w-4 h-4 rounded-full bg-yorik-purple animate-ping"></span>
        </div>
        <h4 class="font-bold text-lg text-white">Yorik Labs R&D Pipeline</h4>
        <p class="text-xs text-yorik-muted">
          Our internal laboratory continuously prototypes on-device AI algorithms, privacy primitives, and intuitive user experiences before integrating them into app products.
        </p>
        <a
          href="/labs"
          class="inline-flex items-center gap-2 text-xs font-semibold text-yorik-cyan hover:text-white transition-colors pt-2"
        >
          <span>Explore All Active R&D Experiments</span>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
          </svg>
        </a>
      </div>
    </div>

  </div>
</section>
