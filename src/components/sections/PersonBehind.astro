---
import SectionHeader from '../common/SectionHeader.astro';
---

<section id="person-behind" class="py-24 relative bg-yorik-bg border-b border-yorik-border/50 overflow-hidden">
  <!-- Ambient background glow elements -->
  <div class="absolute -top-40 -right-40 w-96 h-96 bg-yorik-purple/15 blur-[140px] rounded-full pointer-events-none"></div>
  <div class="absolute -bottom-40 -left-40 w-96 h-96 bg-yorik-cyan/15 blur-[140px] rounded-full pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <SectionHeader
      eyebrow="THE PERSON BEHIND YORIK LABS"
      headline="Product thinker by profession. Builder by passion."
      copy="Behind this growing technology ecosystem is a product person who genuinely enjoys building software."
      gradientText="Builder by passion."
    />

    <div class="mt-16 max-w-4xl mx-auto">
      <div class="glass-panel p-8 sm:p-12 rounded-3xl border border-yorik-purple/40 bg-gradient-to-br from-yorik-surface-elevated/90 via-yorik-surface/80 to-yorik-bg/90 shadow-2xl relative overflow-hidden backdrop-blur-xl">
        
        <!-- Subtle Top Code/Terminal Header -->
        <div class="flex items-center justify-between pb-6 mb-8 border-b border-yorik-border/60">
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-yorik-purple/60"></span>
            <span class="w-3 h-3 rounded-full bg-yorik-cyan/60"></span>
            <span class="w-3 h-3 rounded-full bg-yorik-green/60"></span>
            <span class="font-mono text-xs text-yorik-subtle ml-2">builder.ts</span>
          </div>

          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-[11px] font-mono font-semibold bg-yorik-surface border border-yorik-purple/30 text-yorik-purple-glow">
            <span class="w-1.5 h-1.5 rounded-full bg-yorik-purple animate-pulse"></span>
            <span>Solo Builder</span>
          </div>
        </div>

        <!-- Personal Narrative Content -->
        <div class="space-y-6">
          <p class="text-lg sm:text-xl font-medium text-white leading-relaxed">
            I'm a Product Manager by profession and a developer at heart.
          </p>

          <p class="text-base sm:text-lg text-yorik-muted leading-relaxed">
            I enjoy turning ideas into products — from understanding a problem and shaping the product experience to building, testing and bringing the idea to life.
          </p>

          <p class="text-base sm:text-lg text-yorik-muted leading-relaxed">
            Yorik Labs is where that passion comes together: a place to experiment, build useful software and turn ideas into products that can eventually become part of something much bigger.
          </p>

          <!-- Quote / Personal Statement Box -->
          <div class="mt-8 pt-6 pb-6 px-6 rounded-2xl bg-yorik-surface/60 border border-yorik-cyan/30 relative">
            <div class="absolute top-0 left-0 bottom-0 w-1 bg-gradient-to-b from-yorik-cyan to-yorik-purple rounded-l-2xl"></div>
            <p class="text-base sm:text-lg font-mono text-yorik-cyan leading-relaxed italic">
              "I believe the best way to understand technology is not just to use it, but to build with it."
            </p>
            <p class="text-xs font-mono text-yorik-subtle mt-2 uppercase tracking-wider">
              — That's what drives Yorik Labs.
            </p>
          </div>
        </div>

        <!-- Bottom CTA Bar -->
        <div class="pt-8 mt-8 border-t border-yorik-border/60 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
          <div class="flex items-center gap-2 text-xs font-mono text-yorik-subtle">
            <span class="w-2 h-2 rounded-full bg-yorik-green animate-pulse"></span>
            <span>Product Manager & Solo Developer</span>
          </div>

          <a
            href="https://www.linkedin.com/in/karthikk153/"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-6 py-3 rounded-xl text-xs font-mono font-bold text-white bg-gradient-to-r from-yorik-purple/30 to-yorik-surface border border-yorik-purple/50 hover:border-yorik-purple hover:from-yorik-purple-dark hover:to-yorik-purple transition-all duration-300 hover:scale-[1.02] shadow-glow group"
          >
            <span>VIEW MY LINKEDIN</span>
            <svg class="w-4 h-4 text-yorik-cyan group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          </a>
        </div>

      </div>
    </div>
  </div>
</section>
