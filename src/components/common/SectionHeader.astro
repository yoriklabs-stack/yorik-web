---
export interface Props {
  eyebrow: string;
  headline: string;
  copy?: string;
  align?: 'left' | 'center';
  gradientText?: string;
}

const { eyebrow, headline, copy, align = 'center', gradientText } = Astro.props;
---

<div class={`space-y-4 max-w-3xl ${align === 'center' ? 'mx-auto text-center' : 'text-left'}`}>
  <!-- Eyebrow -->
  <div class={`inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-yorik-surface border border-yorik-purple/30 shadow-sm ${align === 'center' ? 'mx-auto' : ''}`}>
    <span class="w-1.5 h-1.5 rounded-full bg-yorik-purple animate-pulse"></span>
    <span class="font-mono text-xs font-semibold tracking-widest text-yorik-purple-glow uppercase">{eyebrow}</span>
  </div>

  <!-- Headline -->
  <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight">
    {gradientText ? (
      <>
        {headline.replace(gradientText, '')}
        <span class="text-gradient-purple">{gradientText}</span>
      </>
    ) : (
      headline
    )}
  </h2>

  <!-- Supporting Copy -->
  {copy && (
    <p class="text-base sm:text-lg text-yorik-muted leading-relaxed max-w-2xl mx-auto">
      {copy}
    </p>
  )}
</div>
